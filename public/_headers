# CatalystLab edge headers — Cloudflare Pages (owner decision D3, 2026-10-19)
#
# The static frontend is served by Pages, so it needs the same security headers
# the Express API sets with helmet in server/app.ts. Keep the two in step: the
# API remains the source of truth for anything served through /api/*.
# Follow-up (plan item 3.8): narrow connect-src (drop bare ws:/wss:) and move
# style-src 'unsafe-inline' to hashes once the inline theme snippet is hashed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob: https:; object-src 'none'; script-src 'self' 'unsafe-inline' https://apis.google.com https://*.googleapis.com https://*.gstatic.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.gstatic.com; upgrade-insecure-requests; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.catalystlab.tech https://*.run.app wss://www.catalystlab.tech; frame-src 'self' https://*.firebaseapp.com https://*.google.com

# Vite emits content-hashed bundles: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (including every prerendered route shell) must revalidate.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Machine-readable content for agents (D13) is cheap to revalidate hourly.
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# The service worker must never be cached stale.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
