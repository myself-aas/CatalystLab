# CatalystLab edge headers — Cloudflare Pages (owner decision D3 & Plan 3.8)
#
# Kept in strict parity with `server/app.ts` Helmet policy:
#   - Zero 'unsafe-inline' in script-src AND style-src (`scripts/prerender.ts`
#     substitutes exact `'sha256-...'` hashes of built inline <script> blocks
#     into `dist/_headers` during `npm run build`).
#   - Zero wildcard `https:` in img-src (explicit host allowlist only).
#   - Zero bare `ws:` / `wss:` in connect-src (explicit hosts only).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; form-action 'self'; frame-ancestors 'self' https://*.google.com https://*.googleusercontent.com https://*.run.app https://ai.studio; img-src 'self' data: blob: https://www.catalystlab.tech https://cdn.catalystlab.tech https://images.unsplash.com https://images.pexels.com https://cdn.simpleicons.org https://i.pravatar.cc https://github.com https://avatars.githubusercontent.com https://raw.githubusercontent.com https://*.googleusercontent.com https://*.gstatic.com; object-src 'none'; script-src 'self' __INLINE_SCRIPT_HASHES__ https://apis.google.com https://*.googleapis.com https://*.gstatic.com; script-src-attr 'none'; style-src 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=' https://fonts.googleapis.com https://*.gstatic.com; upgrade-insecure-requests; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.catalystlab.tech wss://www.catalystlab.tech https://*.run.app; frame-src 'self' https://*.firebaseapp.com https://*.google.com

# Vite emits content-hashed bundles: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (including every prerendered route shell) must revalidate.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Machine-readable content for agents (D13) is cheap to revalidate hourly.
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# The service worker must never be cached stale.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
