# CatalystLab STAGING environment template (Plan 10.1 parity with production).
# Populate real secrets in the staging secret store; never commit populated values.

HOST=0.0.0.0
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true

APP_ORIGIN=https://staging.catalystlab.tech
VITE_APP_ORIGIN=https://staging.catalystlab.tech

JWT_SECRET=
PAYMENT_SIGNING_SECRET=
ALLOW_UNAUTH_DEMO=false
VALID_API_KEYS=

# Sandbox payments enabled on staging for 2Checkout test verification (Plan 2.4).
PAYMENTS_ENABLED=true
PAYMENT_GATEWAY=2checkout
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SECRET_KEY=
V2CHECKOUT_SANDBOX_MODE=true
DODOPAY_API_KEY=
DODOPAY_WEBHOOK_SECRET=
DODOPAY_SANDBOX_MODE=true

FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

MONGODB_URI=
MONGODB_DB_NAME=catalystlab_staging
TELEMETRY_INGEST_MAX_PER_MIN=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SWEEP_INTERVAL_MS=21600000

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=

GITHUB_WEBHOOK_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.2
