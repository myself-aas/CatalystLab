# CatalystLab — STAGING environment template (Plan 10.1 parity gate).
# Key set MUST match .env.example and .env.production.example exactly
# (scripts/check-env.mjs fails the build on any drift).
# Secrets stay EMPTY here — inject real values from the host environment /
# secret store at deploy time (D14, Q32). Non-secret defaults below mirror
# the code defaults and the staging topology (wrangler.toml env.staging,
# .github/workflows/deploy.yml → https://staging.catalystlab.tech).

# Never allow unauthenticated demo surfaces in a deployed environment.
ALLOW_UNAUTH_DEMO=false
# Canonical staging origin (Worker route: staging.catalystlab.tech/api/*).
APP_ORIGIN=https://staging.catalystlab.tech

# Dodo Payments is dormant (D2): sandbox mode on, secrets injected only if
# PAYMENT_GATEWAY=dodopay is ever set for an experiment.
DODOPAY_API_KEY=
DODOPAY_SANDBOX_MODE=true
DODOPAY_WEBHOOK_SECRET=

# Firebase Admin (server). Provide exactly one of JSON or PATH at deploy time;
# without it, identity routes fail closed with 401 (README security model).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional named Firestore database (serverAuth.ts reads it; default DB when empty).
FIRESTORE_DATABASE_ID=

# All webhook deliveries are rejected without this secret.
GITHUB_WEBHOOK_SECRET=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON (file path on the API host).
GOOGLE_APPLICATION_CREDENTIALS=

# Bind address of the Node API host (Docker/systemd use 0.0.0.0).
HOST=0.0.0.0
# At least one of JWT_SECRET / PAYMENT_SIGNING_SECRET is required in prod/CI.
JWT_SECRET=
# debug in staging (README: info in production, debug otherwise).
LOG_LEVEL=debug

# Unset Mailgun keys ⇒ emails dispatch in mock mode (logged, never sent).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
MAILGUN_HOST=

# Unset ⇒ analytics buffer stays in-memory (zero-cost mode; not for load tests).
MONGODB_DB_NAME=
MONGODB_URI=

# Q32 kill-switch: paid checkout stays OFF until gates 4.1/4.6 + webhook retry pass.
PAYMENTS_ENABLED=false
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
# D2: 2Checkout is the single live gateway.
PAYMENT_GATEWAY=2checkout
PAYMENT_SIGNING_SECRET=

# Unset ⇒ Sentry off; client errors stay in pino logs only (D10).
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Retention sweep cadence; empty ⇒ code default 6 h (server/core/retention.ts).
SWEEP_INTERVAL_MS=
# Telemetry ingest cap per IP per minute; empty ⇒ code default (SEC-2026-02).
TELEMETRY_INGEST_MAX_PER_MIN=
# Staging sits behind the Cloudflare Worker proxy ⇒ trust rightmost XFF hop.
TRUST_PROXY=true

# Unset ⇒ rate-limit counters live in process memory (single-instance only).
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SANDBOX_MODE=true
V2CHECKOUT_SECRET_KEY=
# Comma-separated cat_live_… keys; empty ⇒ api_pro tier disabled.
VALID_API_KEYS=
# Client-build twin of APP_ORIGIN (Q42).
VITE_APP_ORIGIN=https://staging.catalystlab.tech
