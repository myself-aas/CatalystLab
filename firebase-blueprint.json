{
  "entities": {
    "Report": {
      "title": "Audit Report",
      "description": "A saved CatalystLab audit report generated by advanced engines and website scanners.",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "The URL or repository that was audited", "maxLength": 500 },
        "domainSlug": { "type": "string", "description": "Normalized domain slug e.g. stripe-com", "maxLength": 200 },
        "engine": { "type": "string", "description": "The engine or diagnostic type used", "maxLength": 100 },
        "output": { "type": "string", "description": "The formatted terminal or diagnostic output", "maxLength": 500000 },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "ownerId": { "type": "string", "description": "UID of the user who created and owns the report", "maxLength": 128 },
        "ownerEmail": { "type": "string", "description": "Email of the user account", "maxLength": 256 },
        "title": { "type": "string", "description": "Optional title or hostname", "maxLength": 200 },
        "score": { "type": "number", "description": "Calculated score or percentage" }
      },
      "required": ["url", "engine", "output", "createdAt", "ownerId"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Technical article, architecture breakdown, or release notes published by admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Article title", "maxLength": 200 },
        "slug": { "type": "string", "description": "URL slug for the post", "maxLength": 200 },
        "excerpt": { "type": "string", "description": "Short summary description", "maxLength": 500 },
        "content": { "type": "string", "description": "Full markdown or rich text article body", "maxLength": 50000 },
        "category": { "type": "string", "description": "Primary topic category", "maxLength": 100 },
        "tags": { "type": "array", "description": "Topic tags" },
        "authorName": { "type": "string", "description": "Author display name", "maxLength": 100 },
        "authorEmail": { "type": "string", "description": "Author email", "maxLength": 200 },
        "authorAvatar": { "type": "string", "description": "Author avatar photo URL", "maxLength": 500 },
        "status": { "type": "string", "description": "Publication status", "enum": ["published", "draft", "archived"] },
        "readTime": { "type": "string", "description": "Estimated reading time", "maxLength": 50 },
        "coverImage": { "type": "string", "description": "Cover banner image URL", "maxLength": 500 },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in milliseconds" },
        "views": { "type": "number", "description": "Total view count" }
      },
      "required": ["title", "slug", "content", "createdAt"]
    },
    "MonitoredSite": {
      "title": "Monitored Site",
      "description": "Target endpoint configured for uptime, latency, and SSL certificate probes.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Site or service name", "maxLength": 100 },
        "url": { "type": "string", "description": "Target probe URL", "maxLength": 500 },
        "checkIntervalMinutes": { "type": "number", "description": "Heartbeat probe interval in minutes" },
        "status": { "type": "string", "description": "Current health status", "enum": ["healthy", "degraded", "down", "untested"] },
        "lastCheckedAt": { "type": "number", "description": "Timestamp of last probe execution" },
        "responseTimeMs": { "type": "number", "description": "Round trip response latency in milliseconds" },
        "statusCode": { "type": "number", "description": "Last HTTP response status code" },
        "sslDaysRemaining": { "type": "number", "description": "Days until SSL certificate expiry" },
        "sslValid": { "type": "boolean", "description": "Whether SSL certificate is active and valid" },
        "uptimePercentage": { "type": "number", "description": "Calculated uptime percentage" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "ownerId": { "type": "string", "description": "UID of the owner or admin", "maxLength": 128 }
      },
      "required": ["name", "url", "createdAt", "ownerId"]
    },
    "ApiKey": {
      "title": "API Key",
      "description": "API credentials and white-label access tokens for programmatic integrations.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Key identifier or client name", "maxLength": 100 },
        "keyPrefix": { "type": "string", "description": "Masked key prefix for display", "maxLength": 50 },
        "ownerId": { "type": "string", "description": "UID of the user who owns the key", "maxLength": 128 },
        "scopes": { "type": "array", "description": "Permission scopes" },
        "environment": { "type": "string", "description": "Deployment environment" },
        "status": { "type": "string", "description": "Key status", "enum": ["active", "revoked", "expired"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" }
      },
      "required": ["name", "keyPrefix", "ownerId", "scopes", "environment", "status", "createdAt"]
    },
    "ContactInquiry": {
      "title": "Contact Inquiry & Email Lead",
      "description": "User email submissions, contact requests, and newsletter lead captures.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Email address of the user", "maxLength": 256 },
        "name": { "type": "string", "description": "Optional name of the user or company", "maxLength": 150 },
        "message": { "type": "string", "description": "Optional inquiry notes or message", "maxLength": 2000 },
        "source": { "type": "string", "description": "Source origin of the lead e.g. get-in-touch-popup, footer-touch", "maxLength": 100 },
        "company": { "type": "string", "description": "Optional organization or domain name", "maxLength": 200 },
        "status": { "type": "string", "description": "Status of the inquiry", "enum": ["new", "contacted", "resolved", "archived"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "ownerId": { "type": "string", "description": "UID or guest identifier", "maxLength": 128 }
      },
      "required": ["email", "createdAt"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System health, engine execution telemetry, and administrative audit trails.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Diagnostic action or audit name", "maxLength": 150 },
        "status": { "type": "string", "description": "Health status", "enum": ["healthy", "warning", "critical", "info", "success"] },
        "engine": { "type": "string", "description": "Associated diagnostic engine", "maxLength": 100 },
        "target": { "type": "string", "description": "Target hostname or service", "maxLength": 500 },
        "executionTimeMs": { "type": "number", "description": "Execution latency in milliseconds" },
        "statusCode": { "type": "number", "description": "HTTP status or return code" },
        "details": { "type": "string", "description": "Audit details or error synopsis", "maxLength": 2000 },
        "timestamp": { "type": "number", "description": "Timestamp in milliseconds" },
        "ownerId": { "type": "string", "description": "UID of the actor", "maxLength": 128 },
        "userEmail": { "type": "string", "description": "Email of the actor", "maxLength": 256 }
      },
      "required": ["action", "status", "timestamp"]
    },
    "UserSubscription": {
      "title": "User Subscription",
      "description": "User subscription plan, 7-day free trial status, quota limits, and billing details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user", "maxLength": 128 },
        "userEmail": { "type": "string", "description": "User email address", "maxLength": 256 },
        "planId": { "type": "string", "description": "Plan identifier", "enum": ["free", "starter", "pro", "team", "enterprise"] },
        "billingCycle": { "type": "string", "description": "Billing cadence", "enum": ["monthly", "annual"] },
        "status": { "type": "string", "description": "Subscription status", "enum": ["active", "trialing", "canceled", "past_due"] },
        "trialStartedAt": { "type": "number", "description": "Trial start timestamp in ms" },
        "trialEndsAt": { "type": "number", "description": "Trial end timestamp in ms" },
        "trialUsed": { "type": "boolean", "description": "Whether user has consumed their free trial" },
        "createdAt": { "type": "number", "description": "Subscription creation timestamp in ms" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in ms" }
      },
      "required": ["userId", "planId", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "user_subscriptions/{userId}": {
      "schema": "UserSubscription",
      "description": "User subscription tier and 7-day free trial state records."
    },
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Stores saved audit reports associated with users and permalinks."
    },
    "blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Technical insights and engineering articles."
    },
    "blogPosts/{blogPostId}": {
      "schema": "BlogPost",
      "description": "Technical insights and blog posts protected with superadmin claims."
    },
    "audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Live status telemetry and system audit logs."
    },
    "monitored_sites/{siteId}": {
      "schema": "MonitoredSite",
      "description": "Configured endpoints for continuous uptime and latency telemetry."
    },
    "api_keys/{keyId}": {
      "schema": "ApiKey",
      "description": "API keys and white-label configuration records."
    },
    "contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Stores user inquiries, emails, and contact form submissions."
    }
  }
}
