{
  "entities": {
    "User": {
      "title": "User",
      "description": "A researcher profile with academic stats and study counts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier matching the user's Auth UID."
        },
        "username": {
          "type": "string",
          "description": "Unique alphanumeric academic profile handle."
        },
        "full_name": {
          "type": "string",
          "description": "Real or academic name of the researcher."
        },
        "bio": {
          "type": "string",
          "description": "Short summary of scientific interest."
        },
        "demographics": {
          "type": "object",
          "description": "Socio-demographic data."
        },
        "education": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Educational background."
        },
        "career": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Career history."
        },
        "publications": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of publications."
        },
        "awards": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of awards."
        },
        "tokens_remaining": {
          "type": "number",
          "description": "Academic tokens left for AI evaluations."
        },
        "tokens_total": {
          "type": "number",
          "description": "Total historical token quota allocated."
        },
        "tokens_reset_at": {
          "type": "string",
          "description": "ISO timestamp for next token quota reset."
        },
        "geminiApiKey": {
          "type": "string",
          "description": "The user's individual Gemini Api Key."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username"]
    },
    "Session": {
      "title": "Session",
      "description": "A scientific study or active writing session log.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "Topic or focus of this study session."
        },
        "duration": {
          "type": "number",
          "description": "Length of the study session in minutes."
        },
        "notes": {
          "type": "string",
          "description": "Logs compiled during this study session."
        },
        "paper_id": {
          "type": "string",
          "description": "Associated scientific paper ID, if any."
        },
        "instrumentName": {
          "type": "string",
          "description": "Name of the academic synthesis instrument."
        },
        "input": {
          "type": "string",
          "description": "The custom research context or hypothesis input."
        },
        "output": {
          "type": "string",
          "description": "Synthesized academic literature report markdown output."
        },
        "tldr": {
          "type": "string",
          "description": "An executive short summary of the research."
        },
        "noveltyScore": {
          "type": "number",
          "description": "AI-calculated novelty score from 0 to 100."
        },
        "googleDocUrl": {
          "type": "string",
          "description": "The exported direct link of the report on Google Docs."
        },
        "googleSheetUrl": {
          "type": "string",
          "description": "The exported direct link of the literature database on Google Sheets."
        },
        "googleFormUrl": {
          "type": "string",
          "description": "The dynamic generated quiz/survey assessment link on Google Forms."
        },
        "googleGmailRecipient": {
          "type": "string",
          "description": "The destination email address the academic report was sent to via Gmail."
        },
        "googleCalendarEventUrl": {
          "type": "string",
          "description": "The link or ID of the scheduled Google Calendar assessment/event."
        },
        "googleTaskId": {
          "type": "string",
          "description": "The ID of the task created in Google Tasks."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "title", "duration"]
    },
    "Fragment": {
      "title": "Fragment",
      "description": "A research idea, citation link, or collaborative micro-note.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "content"]
    },
    "Post": {
      "title": "Post",
      "description": "An academic discussion post or publication share on the discovery feed.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "authorId": {
          "type": "string",
          "description": "The UID of the post author."
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author."
        },
        "authorPhoto": {
          "type": "string",
          "description": "Profile picture URL of the author."
        },
        "content": {
          "type": "string",
          "description": "Textual contents of the post."
        },
        "attachments": {
          "type": "array",
          "description": "List of attached images, articles, or datasets."
        },
        "likes": {
          "type": "number",
          "description": "Count of researcher likes."
        },
        "commentsCount": {
          "type": "number",
          "description": "Count of text replies."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "authorName", "content", "likes", "commentsCount"]
    },
    "Blog": {
      "title": "Blog",
      "description": "An academic full-length blog post.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "authorId": {
          "type": "string",
          "description": "The UID of the post author."
        },
        "title": {
          "type": "string",
          "description": "Title of the blog."
        },
        "content": {
          "type": "string",
          "description": "Full-length markdown content of the blog."
        },
        "authorName": {
          "type": "string",
          "description": "The name of the author."
        },
        "authorAvatar": {
          "type": "string",
          "description": "The URL of the author's avatar."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags for the blog post."
        },
        "reactions": {
          "type": "object",
          "description": "Like, dislike, insightful, sad, angry, confused, brainstorming count map."
        },
        "favouriteCount": {
          "type": "number",
          "description": "Number of users who favourited this."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "title", "content"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a blog post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content"]
    },
    "Template": {
      "title": "Template",
      "description": "A reusable blog template.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "usageCount": { "type": "number" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content", "usageCount"]
    },
    "Draft": {
      "title": "Draft",
      "description": "A draft of an academic blog post.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "authorId": {
          "type": "string",
          "description": "The UID of the post author."
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "title", "content"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles and token statuses."
    },
    "sessions": {
      "schema": "Session",
      "description": "Logged research study sessions."
    },
    "fragments": {
      "schema": "Fragment",
      "description": "Logged research insight fragments and quick notes."
    },
    "posts": {
      "schema": "Post",
      "description": "Academic social discussion and publication thread posts."
    },
    "blogs": {
      "schema": "Blog",
      "description": "Full length academic blog posts."
    },
    "drafts": {
      "schema": "Draft",
      "description": "Full length academic blog drafts."
    }
  }
}
