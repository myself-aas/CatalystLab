{
  "name": "catalystlab",
  "version": "2.4.0",
  "private": true,
  "description": "Website-quality intelligence platform: a Vite 8 + React 19 SPA with an integrated Express 5 server that runs website-audit engines against user-supplied URLs, metered by a tiered rate limiter, with Firebase auth/Firestore on the client, MongoDB analytics, and fail-closed payment-gateway integrations.",
  "homepage": "https://github.com/myself-aas/CatalystLab#readme",
  "bugs": {
    "url": "https://github.com/myself-aas/CatalystLab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myself-aas/CatalystLab.git"
  },
  "license": "CC-BY-4.0",
  "author": "Ashif Ahmed Shuvo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run --sequence.shuffle",
    "test:e2e": "playwright test",
    "test:load": "node scripts/run-loadtest.mjs",
    "test:payments-sandbox": "tsx scripts/e2e-payment-sandbox.ts",
    "drill:restore": "tsx scripts/run-restore-drill.ts",
    "sec:secrets": "node scripts/scan-secrets.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "npm run check:env && npm run check:colors && npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle && npm run check:deps",
    "check:env": "node scripts/check-env.mjs",
    "media:check": "node scripts/verify-media.mjs",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lhci": "lhci autorun",
    "ci:full": "npm run ci && npm run test:coverage && npm run drill:restore && npm run test:payments-sandbox && npm run sec:secrets",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:colors": "node scripts/check-raw-color-literals.mjs",
    "check:deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "@sentry/node": "^11.16.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "d3": "^7.9.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.77.0",
    "mongodb": "^7.9.1",
    "motion": "^14.14.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.3.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^31.0.1",
    "playwright": "^1.64.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@puppeteer/browsers": "^3.2.5",
    "argparse": "^2.0.1",
    "basic-ftp": "^6.2.3",
    "minimatch": "^11.0.1",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "glob": "^14.0.6"
  }
}
