{
  "name": "catalystlab",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run --sequence.shuffle",
    "test:e2e": "playwright test",
    "test:load": "node scripts/run-loadtest.mjs",
    "test:payments-sandbox": "tsx scripts/e2e-payment-sandbox.ts",
    "drill:restore": "tsx scripts/run-restore-drill.ts",
    "sec:secrets": "node scripts/scan-secrets.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "npm run check:env && npm run check:colors && npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle",
    "check:env": "node scripts/check-env.mjs",
    "media:check": "node scripts/verify-media.mjs",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lhci": "lhci autorun",
    "ci:full": "npm run ci && npm run test:coverage && npm run drill:restore && npm run test:payments-sandbox && npm run sec:secrets",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:colors": "node scripts/check-raw-color-literals.mjs"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "d3": "^7.9.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.60.0",
    "mongodb": "^7.7.0",
    "motion": "^14.4.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@puppeteer/browsers": "^3.2.5",
    "argparse": "^2.0.1",
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
