# --- Runtime mode (non-secret defaults; identical in .env.staging/.env.production) ---
# Server code requires NODE_ENV=production for secure defaults (CSP, static hosting,
# noindex app shells). PORT/HOST honour the env; server.ts falls back to 3000/0.0.0.0.
NODE_ENV=production
PORT=3000
