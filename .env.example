# CatalystLab environment template.
#
# Copy to `.env` for local development and fill in only what you need: every
# variable here is optional in development and `npm run check:env` (part of
# `npm run ci`) fails only when a value that production needs is missing or when
# `.env.staging.example` / `.env.production.example` drift in key parity (Plan 10.1).
# Never commit a filled-in copy. Secrets belong in the host secret store or CI secrets.

# ---------------------------------------------------------------------------
# Runtime and origin (Q40, Q42, D14)
# ---------------------------------------------------------------------------
HOST=
PORT=
NODE_ENV=
LOG_LEVEL=
# Set to true only behind a trusted proxy (the Cloudflare Worker in front of the
# API host); clientIp() reads the RIGHTMOST X-Forwarded-For entry (Plan 3.6).
TRUST_PROXY=

# Canonical origin (D14: www is canonical).
# Production: https://www.catalystlab.tech | Staging: https://staging.catalystlab.tech
APP_ORIGIN=
VITE_APP_ORIGIN=

# ---------------------------------------------------------------------------
# Auth and signing (Q42, D1/D2)
# ---------------------------------------------------------------------------
JWT_SECRET=
PAYMENT_SIGNING_SECRET=
ALLOW_UNAUTH_DEMO=
VALID_API_KEYS=

# ---------------------------------------------------------------------------
# Payments (D1, D2, Q32).
# Paid checkout stays OFF (`PAYMENTS_ENABLED=false`) until live shared state
# (Upstash Redis, Plan 4.1), scheduled cloud backups + staging restore (4.6),
# and live gateway credentials are verified.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false
PAYMENT_GATEWAY=2checkout
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SECRET_KEY=
V2CHECKOUT_SANDBOX_MODE=true
DODOPAY_API_KEY=
DODOPAY_WEBHOOK_SECRET=
DODOPAY_SANDBOX_MODE=true

# ---------------------------------------------------------------------------
# Firebase (accounts, API keys, subscriptions, contact messages)
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Telemetry store, shared rate limits, and retention (D9, 3.2, 4.1)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=
TELEMETRY_INGEST_MAX_PER_MIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SWEEP_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=

# ---------------------------------------------------------------------------
# GitHub webhooks (fails closed in production when unset — Plan 3.7)
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Error tracking (D10 — explicit dataCollection PII-disabled config on Sentry v11)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
