# CatalystLab environment template.
#
# Copy to `.env` for local development and fill in only what you need: every
# variable here is optional in development and `npm run check:env` (part of
# `npm run ci`) fails only when a value that production needs is missing.
# Never commit a filled-in copy. Secrets belong in the host environment or the
# CI secret store (docs/ops/runbook.md §6).

# ---------------------------------------------------------------------------
# Runtime and origin (Q40, Q42)
# ---------------------------------------------------------------------------
# Port and bind address for `npm run dev` and `npm start`. PORT falls back to
# 3000 and HOST to 0.0.0.0 when unset.
HOST=
PORT=
NODE_ENV=
LOG_LEVEL=
# Set to true only behind a trusted proxy (the Cloudflare Worker in front of the
# API host); it makes the API read the leftmost X-Forwarded-For entry.
TRUST_PROXY=

# Canonical origin, used to build every canonical/og:url, the sitemap and the
# prerendered shells. APP_ORIGIN is read by Node (prerender, server,
# check:env); VITE_APP_ORIGIN is the same value for the browser build.
# Production: https://www.catalystlab.tech
APP_ORIGIN=
VITE_APP_ORIGIN=

# ---------------------------------------------------------------------------
# Auth and signing (Q42, D1/D2)
# ---------------------------------------------------------------------------
# check:env requires at least one of JWT_SECRET / PAYMENT_SIGNING_SECRET.
JWT_SECRET=
PAYMENT_SIGNING_SECRET=
ALLOW_UNAUTH_DEMO=
VALID_API_KEYS=

# ---------------------------------------------------------------------------
# Payments (D1, D2). Checkout answers 503 PAYMENTS_NOT_CONFIGURED until the
# signing secret for the selected gateway is set. Paid checkout stays off until
# plan items 4.1 and 4.6 and the webhook retry test pass (Q32).
# ---------------------------------------------------------------------------
# 2checkout (default) or dodopay (D2 switch).
PAYMENT_GATEWAY=
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SECRET_KEY=
V2CHECKOUT_SANDBOX_MODE=
DODOPAY_API_KEY=
DODOPAY_WEBHOOK_SECRET=
DODOPAY_SANDBOX_MODE=

# ---------------------------------------------------------------------------
# Firebase (accounts, API keys, subscriptions, contact messages)
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Telemetry store and quota (answer #1, answer #2, D9)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=
# Rate limits and the daily quota ledger. Without these the counters live in
# process memory and reset on restart, which is not acceptable in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Retention sweep interval in milliseconds (default 6 hours).
SWEEP_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=

# ---------------------------------------------------------------------------
# GitHub webhooks. Fails closed: with no secret the endpoint rejects every
# delivery rather than accepting unsigned ones.
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Error tracking (D10). Off unless SENTRY_DSN is set; events are scrubbed of
# emails, IP addresses, cookies, headers and credentials before they leave the
# process, and browser errors relay through POST /api/client-logs.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
