# CatalystLab PRODUCTION environment template (Plan 5.6, 10.1, D14, Q32).
# Populate real secrets ONLY in the platform secret store (Oracle systemd EnvironmentFile
# mode 0600 owned by root, Cloudflare Pages/Worker secrets, GitHub Environment secrets).
# Never commit populated values to Git.

HOST=0.0.0.0
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true

# D14: www is canonical; apex 301s to www.
APP_ORIGIN=https://www.catalystlab.tech
VITE_APP_ORIGIN=https://www.catalystlab.tech

JWT_SECRET=
PAYMENT_SIGNING_SECRET=
ALLOW_UNAUTH_DEMO=false
VALID_API_KEYS=

# Q32: Paid checkout MUST remain false in production until live Upstash Redis (4.1)
# and daily scheduled Firestore/Mongo backups + staging restore (4.6) are active.
PAYMENTS_ENABLED=false
PAYMENT_GATEWAY=2checkout
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SECRET_KEY=
V2CHECKOUT_SANDBOX_MODE=false
DODOPAY_API_KEY=
DODOPAY_WEBHOOK_SECRET=
DODOPAY_SANDBOX_MODE=false

FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

MONGODB_URI=
MONGODB_DB_NAME=catalystlab_prod
TELEMETRY_INGEST_MAX_PER_MIN=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SWEEP_INTERVAL_MS=21600000

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=

GITHUB_WEBHOOK_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
