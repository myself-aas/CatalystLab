# CatalystLab — PRODUCTION environment template (Plan 10.1 parity gate).
# Key set MUST match .env.example and .env.staging.example exactly
# (scripts/check-env.mjs fails the build on any drift).
# Hard gate: APP_ORIGIN below MUST stay "https://www.catalystlab.tech" (D14
# canonical www host) and PAYMENTS_ENABLED MUST stay "false" until the Q32
# checkout gates pass. Secrets stay EMPTY here — inject real values from the
# host environment / secret store at deploy time, never into Git.

# Never allow unauthenticated demo surfaces in production.
ALLOW_UNAUTH_DEMO=false
# Canonical production origin (D14; enforced by scripts/check-env.mjs).
APP_ORIGIN=https://www.catalystlab.tech

# Dodo Payments is dormant (D2): production mode, secrets injected only if
# PAYMENT_GATEWAY=dodopay is ever explicitly enabled.
DODOPAY_API_KEY=
DODOPAY_SANDBOX_MODE=false
DODOPAY_WEBHOOK_SECRET=

# Firebase Admin (server). Provide exactly one of JSON or PATH at deploy time;
# without it, identity routes fail closed with 401 (README security model).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional named Firestore database (serverAuth.ts reads it; default DB when empty).
FIRESTORE_DATABASE_ID=

# All webhook deliveries are rejected without this secret.
GITHUB_WEBHOOK_SECRET=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON (file path on the API host).
GOOGLE_APPLICATION_CREDENTIALS=

# Bind address of the Node API host (Docker/systemd use 0.0.0.0).
HOST=0.0.0.0
# At least one of JWT_SECRET / PAYMENT_SIGNING_SECRET is required in prod/CI.
JWT_SECRET=
# README: info in production.
LOG_LEVEL=info

# Unset Mailgun keys ⇒ emails dispatch in mock mode (logged, never sent).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
MAILGUN_HOST=

# REQUIRED in production for durable analytics: unset ⇒ in-memory buffer that
# resets on restart (README: "not acceptable in production").
MONGODB_DB_NAME=
MONGODB_URI=

# Q32 kill-switch: paid checkout stays OFF (503 PAYMENTS_DISABLED) until items
# 4.1/4.6 and the webhook retry test pass. Production additionally requires an
# active Upstash Redis (503 PAYMENTS_SHARED_STATE_REQUIRED, SEC-2026-08).
PAYMENTS_ENABLED=false
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
# D2: 2Checkout is the single live gateway.
PAYMENT_GATEWAY=2checkout
PAYMENT_SIGNING_SECRET=

# Unset ⇒ Sentry off; client errors stay in pino logs only (D10).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Retention sweep cadence; empty ⇒ code default 6 h (server/core/retention.ts).
SWEEP_INTERVAL_MS=
# Telemetry ingest cap per IP per minute; empty ⇒ code default (SEC-2026-02).
TELEMETRY_INGEST_MAX_PER_MIN=
# Production sits behind the Cloudflare Worker proxy ⇒ trust rightmost XFF hop
# (SEC-2026-06: worker appends cf-connecting-ip as the rightmost entry).
TRUST_PROXY=true

# REQUIRED in production: unset ⇒ per-process memory counters that reset on
# restart and fragment across instances (README: "not acceptable in production").
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SANDBOX_MODE=false
V2CHECKOUT_SECRET_KEY=
# Comma-separated cat_live_… keys; empty ⇒ api_pro tier disabled.
VALID_API_KEYS=
# Client-build twin of APP_ORIGIN (Q42).
VITE_APP_ORIGIN=https://www.catalystlab.tech
