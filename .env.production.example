# CatalystLab production environment template.
# Copy to `.env.production.local` and fill real values. `scripts/check-env.mjs`
# (part of `npm run check:env` / `npm run ci`) enforces the required ones.

# ----------------------------------------------------------------------------
# REQUIRED (hard-fails in production / CI)
# ----------------------------------------------------------------------------
# Firebase Admin credential. Set either the inline JSON or the file path.
# Inline JSON must be a single line escaped for dotenv: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Canonical public origin (used for absolute links / security headers / OAuth).
APP_ORIGIN=https://catalystlab.tech
VITE_APP_ORIGIN=https://catalystlab.tech

# ----------------------------------------------------------------------------
# SECURITY & AUTH
# ----------------------------------------------------------------------------
# Set to "true" only when running behind a trusted reverse proxy so rate
# limiters read X-Forwarded-For. Never exposed directly to the internet.
TRUST_PROXY=true

# Legacy inline API-key allowlist (comma separated `cat_live_...` secrets).
# New keys should be managed through the persisted Firestore api_keys store.
VALID_API_KEYS=

# HMAC secrets used to verify webhooks / signed URLs if enabled.
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET_2CHECKOUT=
PAYMENTS_WEBHOOK_SECRET_DODOPAY=
GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# RATE LIMITING (recommended for multi-instance deployments)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# PAYMENTS (set according to your provider)
# ----------------------------------------------------------------------------
V2CHECKOUT_MERCHANT_CODE=
V2CHECKOUT_SECRET_KEY=
V2CHECKOUT_SANDBOX_MODE=false
DODOPAY_API_KEY=
DODOPAY_SANDBOX_MODE=false

# ----------------------------------------------------------------------------
# OPTIONAL SERVICES
# ----------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
MONGODB_URI=
MONGODB_DB_NAME=

# ----------------------------------------------------------------------------
# RUNTIME
# ----------------------------------------------------------------------------
HOST=0.0.0.0
LOG_LEVEL=info
ALLOW_UNAUTH_DEMO=false
