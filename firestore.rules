rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Primary Superadmins registry & Custom Claim verification
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.superadmin == true ||
        request.auth.token.email == 'shuvo.1807016@bau.edu.bd' ||
        request.auth.token.email == 'shuvoasifahmed@gmail.com' ||
        request.auth.token.email == 'asifahmedshuvo.aas@gmail.com' ||
        request.auth.token.email == 'asifahmedshuvo.aa9@gmail.com'
      );
    }

    function hasSuperAdminClaim() {
      return isSignedIn() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.superadmin == true ||
        request.auth.token.email == 'shuvo.1807016@bau.edu.bd' ||
        request.auth.token.email == 'shuvoasifahmed@gmail.com' ||
        request.auth.token.email == 'asifahmedshuvo.aas@gmail.com' ||
        request.auth.token.email == 'asifahmedshuvo.aa9@gmail.com'
      );
    }
    
    function isValidReport(data) {
      return data.keys().hasAll(['url', 'engine', 'output', 'createdAt', 'ownerId'])
        && data.keys().size() >= 5 && data.keys().size() <= 12
        && data.url is string && data.url.size() <= 500
        && data.engine is string && data.engine.size() <= 100
        && data.output is string && data.output.size() <= 500000
        && data.createdAt is number
        && data.ownerId is string && (data.ownerId == request.auth.uid || data.ownerId == 'guest');
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'slug', 'content', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && data.slug is string && data.slug.size() <= 200
        && data.content is string && data.content.size() <= 50000
        && data.createdAt is number;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'status', 'timestamp'])
        && data.action is string && data.action.size() <= 150
        && data.status in ['healthy', 'warning', 'critical', 'info', 'success']
        && data.timestamp is number;
    }

    function isValidMonitoredSite(data) {
      return data.keys().hasAll(['name', 'url', 'createdAt', 'ownerId'])
        && data.name is string && data.name.size() <= 100
        && data.url is string && data.url.size() <= 500
        && data.createdAt is number
        && data.ownerId is string;
    }

    function isValidApiKey(data) {
      return data.keys().hasAll(['name', 'keyPrefix', 'ownerId', 'scopes', 'environment', 'status', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.keyPrefix is string && data.keyPrefix.size() <= 50
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.scopes is list && data.scopes.size() <= 10
        && data.environment is string
        && data.status in ['active', 'revoked', 'expired']
        && data.createdAt is number;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().size() >= 2 && data.keys().size() <= 10
        && data.email is string && data.email.size() <= 256
        && data.createdAt is number;
    }

    function isValidUserSubscription(data) {
      return data.keys().hasAll(['userId', 'planId', 'status', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.planId in ['free', 'starter', 'pro', 'team', 'enterprise']
        && data.status in ['active', 'trialing', 'canceled', 'past_due']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // User Subscriptions Collection (Owner or Superadmin)
    match /user_subscriptions/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create, update: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && isValidUserSubscription(incoming());
      allow delete: if isSignedIn() && isSuperAdmin();
    }
    
    // Reports Collection
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() 
                    && isValidId(reportId)
                    && isValidReport(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(reportId) && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // Audit Logs Collection (Live System Health telemetry)
    match /audit_logs/{logId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() 
                    && isValidId(logId) 
                    && isValidAuditLog(incoming());
      allow update, delete: if isSuperAdmin();
    }

    // Blog Posts Collection (Public Read, Only users with 'role: superadmin' claim can create, update, or delete)
    match /blogPosts/{blogPostId} {
      allow get, list: if true;
      allow create: if hasSuperAdminClaim()
                    && isValidId(blogPostId)
                    && isValidBlogPost(incoming());
      allow update: if hasSuperAdminClaim()
                    && isValidId(blogPostId)
                    && isValidBlogPost(incoming());
      allow delete: if hasSuperAdminClaim()
                    && isValidId(blogPostId);
    }

    // Blogs Collection alias
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create: if hasSuperAdminClaim()
                    && isValidId(blogId)
                    && isValidBlogPost(incoming());
      allow update: if hasSuperAdminClaim()
                    && isValidId(blogId)
                    && isValidBlogPost(incoming());
      allow delete: if hasSuperAdminClaim()
                    && isValidId(blogId);
    }

    // API Keys Collection (Owner or Superadmin)
    match /api_keys/{keyId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() 
                    && isValidId(keyId)
                    && isValidApiKey(incoming());
      allow update: if isSignedIn() 
                    && isValidId(keyId) 
                    && (existing().ownerId == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn() 
                    && isValidId(keyId) 
                    && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // Monitored Sites Collection (Superadmin or Owner)
    match /monitored_sites/{siteId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() 
                    && isValidId(siteId)
                    && isValidMonitoredSite(incoming());
      allow update: if isSignedIn() 
                    && isValidId(siteId)
                    && (existing().ownerId == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn() 
                    && isValidId(siteId) 
                    && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // Contact Inquiries & Email Leads (Guest & User create, Admin management)
    match /contact_inquiries/{inquiryId} {
      allow get, list: if isSignedIn() && isSuperAdmin();
      allow create: if isValidId(inquiryId)
                    && isValidContactInquiry(incoming());
      allow update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Test collection for initial connectivity verification
    match /test/{testId} {
      allow get: if isValidId(testId);
    }
  }
}
