rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidReport(data) {
      return data.keys().hasAll(['url', 'engine', 'output', 'createdAt', 'ownerId'])
        && data.keys().size() >= 5 && data.keys().size() <= 10
        && data.url is string && data.url.size() <= 500
        && data.engine is string && data.engine.size() <= 100
        && data.output is string && data.output.size() <= 500000
        && data.createdAt is number
        && data.ownerId is string && data.ownerId == request.auth.uid;
    }
    
    match /reports/{reportId} {
      // allow get for shareable permalinks
      allow get: if isValidId(reportId);
      
      // allow list for the owner only
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && isValidId(reportId)
                    && isValidReport(incoming()) 
                    && incoming().createdAt is number;
                    
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(reportId) && existing().ownerId == request.auth.uid;
    }
  }
}
